# HTTP server port for both the web UI and REST API (single port serves everything)
# Pick something unlikely to collide with common dev servers
FYNANCE_PORT=7433

# Full path to the SQLite database file
# Leave empty to use the OS default: ~/.local/share/fynance/fynance.db (Linux),
# ~/Library/Application Support/fynance/fynance.db (macOS), %APPDATA%\fynance\fynance.db (Windows)
# In Docker this is set automatically to /home/fynance/data/fynance.db
FYNANCE_DB_PATH=

# Bind address for the HTTP server
# Default 127.0.0.1 restricts access to localhost only (recommended for local use)
# Set to 0.0.0.0 to listen on all interfaces (done automatically in Docker so port mapping works)
FYNANCE_HOST=127.0.0.1

# Anthropic API key for LLM-based CSV import (https://console.anthropic.com/).
# Pay-per-token Console billing. Used by `fynance import` and the parse endpoint
# when no subscription token is set (or as the runtime fallback when one is).
FYNANCE_ANTHROPIC_API_KEY=

# Claude subscription OAuth token, obtained by running `claude setup-token`
# (starts with sk-ant-oat01-). Draws from your Claude Pro/Max "Agent SDK credit"
# pool instead of pay-per-token Console billing, so a typical import costs nothing
# extra beyond your existing subscription.
#
# When this is set, the parse pipeline (and CSV import) prefer it over
# FYNANCE_ANTHROPIC_API_KEY. If both are set, the API key is used as an automatic
# fallback when the subscription token is rejected or its monthly credit is
# exhausted. Everything else (prompts, models, output, streaming, PDF support) is
# identical regardless of which credential is used. Per-request, callers may force
# a credential via the parse endpoint's experimental.auth field
# ("auto" | "subscription" | "api_key").
#
# NOTE: using a subscription OAuth token from a third-party app is outside
# Anthropic's Consumer Terms for that token type. Set this only if you accept that.
FYNANCE_CLAUDE_CODE_OAUTH_TOKEN=

# Claude model used by the statement/CSV parser (the "standard" tier).
# Defaults to claude-sonnet-4-6. Haiku can be set here to cut cost, but it is
# not the default: it intermittently omits required empty arrays from output.
FYNANCE_IMPORT_LLM_MODEL=claude-sonnet-4-6

# File-level detection confidence threshold [0.0–1.0].
# If the LLM's confidence that a file is a valid bank statement falls below
# this, the import fails hard rather than ingesting garbage.
# Default 0.80 — unknown-but-valid banks typically score ≥ 0.85.
FYNANCE_IMPORT_MIN_DETECT_CONF=0.80

# Row-level confidence threshold [0.0–1.0].
# Rows below this are skipped with a warning; the rest of the file still ingests.
# Default 0.70 — covers preamble lines, totals rows, and ambiguous formats.
FYNANCE_IMPORT_MIN_ROW_CONF=0.70

# PDF parsing uses a more capable model for visual document understanding
# FYNANCE_PARSE_PDF_MODEL=claude-sonnet-4-6

# LLM provider for the /api/parse endpoint and CSV import.
# Options: "anthropic" (default), "openai", "gemini"
# FYNANCE_PARSE_PROVIDER=anthropic

# OpenAI settings (only needed if FYNANCE_PARSE_PROVIDER=openai)
# FYNANCE_OPENAI_API_KEY=sk-...
# FYNANCE_OPENAI_TEXT_MODEL=gpt-4o-mini
# FYNANCE_OPENAI_PDF_MODEL=gpt-4o
# Point at any OpenAI-compatible server (e.g. a local llama.cpp server).
# When set, FYNANCE_OPENAI_API_KEY becomes optional; without a key no
# Authorization header is sent. Default: https://api.openai.com/v1
# FYNANCE_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# Per-request timeout in seconds; raise it for slow local models. Default: 300
# FYNANCE_OPENAI_TIMEOUT_SECS=300
# How the extraction tool call is requested. Default: required (the string
# form, the only one some OpenAI-compatible servers honour; with a single
# tool it is equivalent to naming it). function sends the explicit named-tool
# object form; auto lets the model answer without a tool call (a JSON
# fallback is then attempted).
# FYNANCE_OPENAI_TOOL_CHOICE=required
# Output token cap per chat call. Default: 16384. 0 omits the field entirely
# and lets the server decide. Local servers often set 64000.
# FYNANCE_OPENAI_MAX_TOKENS=16384
# Sampling temperature. When unset nothing is sent: some OpenAI reasoning
# models reject a non-default temperature.
# FYNANCE_OPENAI_TEMPERATURE=0
# JSON object merged into every chat request, last. The generic escape hatch
# for server-specific knobs (the example below turns Qwen-style thinking
# off). Reserved keys (model, messages, tools, tool_choice, stream,
# stream_options) are rejected at startup.
# FYNANCE_OPENAI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Stream chat responses. Default: true: gives parse progress events and
# makes the server stop generating when Fynance gives up. false keeps the
# non-streaming path.
# FYNANCE_OPENAI_STREAM=true
# How PDFs reach the model. both (default): per-page text plus a page image,
# via the external pdf-extract tool below. images: page images only. text:
# the text layer, with an image fallback for scanned pages. native: send the
# PDF itself as a file part; needs no tool but only works on servers that
# accept PDFs.
# FYNANCE_OPENAI_PDF_MODE=both
# Max PDF pages sent in one parse call, counted across all PDFs in the call.
# Default: 50.
# FYNANCE_OPENAI_PDF_MAX_PAGES=50

# pdf-extract tool: an external CLI (its own project, not part of Fynance)
# that converts a PDF into per-page text plus PNG page images. Used by the
# openai provider for PDFs unless FYNANCE_OPENAI_PDF_MODE=native.
# Path to the tool's executable, or to a wrapper script.
# FYNANCE_PDF_EXTRACT_CMD=pdf-extract
# Extra arguments as a JSON array of strings, e.g. lower page-image DPI.
# FYNANCE_PDF_EXTRACT_ARGS=["--dpi","150"]
# Timeout per tool run in seconds. Default: 120.
# FYNANCE_PDF_EXTRACT_TIMEOUT_SECS=120

# Opt-in raw-output dump for unified parses: when set, each call writes the
# model's raw extraction JSON to this directory (one file per call, named
# {timestamp}-{account_id}-unified.json). The dumps contain your actual
# financial data, and the written path is logged. Unset by default.
# FYNANCE_PARSE_DUMP_DIR=

# Gemini settings (only needed if FYNANCE_PARSE_PROVIDER=gemini)
# FYNANCE_GEMINI_API_KEY=AIzaSy...
# FYNANCE_GEMINI_TEXT_MODEL=gemini-3.8-flash
# FYNANCE_GEMINI_PDF_MODEL=gemini-3.8-flash

# Business income sync (POST /api/income-sources/:id/sync). The URL is the shop
# app's income endpoint; the token is sent as `Authorization: Bearer`. Both must
# be set for the sync to run. The token is never logged.
# FYNANCE_SHOP_SYNC_URL=https://shop.example.com/api/fynance/income
# FYNANCE_SHOP_SYNC_TOKEN=

# Log verbosity level
# Options: trace, debug, info, warn, error
FYNANCE_LOG_LEVEL=info

# Frontend: force mock data mode (disables live API toggle in settings).
# Set to "true" for demo/preview deployments. Leave empty or unset for normal use.
VITE_MOCK_ONLY=
