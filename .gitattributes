# Auto-generated TypeScript bindings (ts-rs) are always written with LF.
# Without this, Windows core.autocrlf=true makes every backend build
# re-dirty them (LF working tree vs CRLF index), polluting diffs.
frontend/src/bindings/** text eol=lf

# Shell scripts must keep LF endings. Git runs a core.hooksPath hook with
# `sh`, and on Linux (CI, and any contributor not on Windows) a CRLF script
# fails with a confusing "not found" on the interpreter line. Without this,
# an edit on a Windows box with core.autocrlf=true silently commits CRLF and
# breaks the pre-push gate for everyone else.
*.sh text eol=lf
.githooks/** text eol=lf
